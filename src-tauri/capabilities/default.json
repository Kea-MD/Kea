{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for Kea editor windows",
  "windows": ["main", "kea-*"],
  "permissions": [
    "core:default",
    "opener:default",
    "core:window:allow-start-dragging",
    "dialog:default",
    "fs:default",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "process:default",
    "updater:default"
  ]
}
