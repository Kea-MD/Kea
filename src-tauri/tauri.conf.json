{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kea",
  "version": "../package.json",
  "identifier": "com.galengreen.kea",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist-react"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "",
        "shadow": false,
        "resizable": true,
        "maximized": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 32,
          "y": 38
        },
        "transparent": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "fileAssociations": [
      {
        "ext": ["md", "markdown", "mdown", "mkd"],
        "name": "Markdown",
        "description": "Markdown Document",
        "role": "Editor"
      }
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU5MzQ4RjVDOTA3QTY4QjIKUldTeWFIcVFYSTgwNlZzZWJvbElaV0t0cDQyRHFZZjk1eVRVYTE1UGxuOU9yQ2ZJQkhwUE1SdzUK",
      "endpoints": [
        "https://github.com/kea-md/Kea/releases/latest/download/latest.json"
      ]
    }
  }
}
